NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Fallback key used only by local scripts/tests, never by the API itself --
# see app/config.py. Not needed if you're only running the API.
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
APP_ENV=development
LOG_LEVEL=INFO

# Maps API keys to a tenant: their group_id (Graphiti's data-isolation
# mechanism) and their OWN Gemini API key -- see app/security.py and
# app/config.py's TenantConfig. Each tenant's own key is billed for their own
# usage; nobody shares the operator's key. Generate a real API key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TENANT_API_KEYS={"local-dev-key": {"group_id": "acme_demo", "gemini_api_key": "their_own_google_api_key_here"}}
