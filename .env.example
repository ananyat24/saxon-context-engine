NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Which LLM provider build_graphiti() uses: "gemini" (default, per-tenant
# keys), "azure_openai" (one shared enterprise resource, no per-tenant
# billing isolation but not subject to Gemini's free-tier rate limit), or
# "anthropic" (Claude for extraction/chat/answer-synthesis -- still needs
# GOOGLE_API_KEY below for embeddings/reranking, since Claude has no
# embeddings API of its own). See app/graph/graphiti_adapter.py.
LLM_PROVIDER=gemini

# Fallback key used only by local scripts/tests, never by the API itself --
# see app/config.py. Not needed if you're only running the API.
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001

# Only used when LLM_PROVIDER=azure_openai. Get these from the Azure Portal
# resource's "Keys and Endpoint" page. The two deployment names are whatever
# you named the deployments when you created them in Azure OpenAI Studio, not
# necessarily the underlying model's name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Local spend caps for Azure OpenAI, enforced by the app itself -- see
# app/graph/spend_limiter.py. Useful when you hold an API key but not portal
# access to set a real cap on the resource. Two independent budgets: one for
# data ingestion runs (scripts/ingest_samples.py etc.), one for live/testing
# queries against the API. Once a bucket hits its budget, further calls in
# that bucket are refused (not made) until you raise the number here.
AZURE_OPENAI_INGESTION_BUDGET_USD=30
AZURE_OPENAI_QUERY_BUDGET_USD=20
# Estimated $ per 1M tokens, used to translate token usage into the spend
# tracked above. Defaults match GPT-4.1 (~$2 in / ~$8 out per 1M tokens) +
# text-embedding-3-small ($0.02/1M) -- if your actual deployments use
# different models, update these so the estimate is meaningful. Check the
# exact current price on each deployment's page in Azure AI Foundry, or
# https://azure.microsoft.com/pricing/details/cognitive-services/openai-service/.
# Other common embedding prices, if you're on a different one:
#   text-embedding-3-large: 0.13   text-embedding-ada-002: 0.10
AZURE_OPENAI_INPUT_PRICE_PER_1M=2.00
AZURE_OPENAI_OUTPUT_PRICE_PER_1M=8.00
AZURE_OPENAI_EMBEDDING_PRICE_PER_1M=0.02

# Only used when LLM_PROVIDER=anthropic. Get a key from
# https://console.anthropic.com/. Shares the same ingestion/query spend
# budgets as Azure OpenAI above (AZURE_OPENAI_INGESTION_BUDGET_USD /
# AZURE_OPENAI_QUERY_BUDGET_USD) -- those are provider-agnostic "how much
# this app can spend" caps, not duplicated per-provider.
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5
# If your key was issued through Microsoft Foundry (same place as an Azure
# OpenAI resource) rather than directly from console.anthropic.com, set this
# to the resource name -- the first segment of
# https://<resource>.services.ai.azure.com/anthropic/. Leave blank/unset for
# a direct Anthropic key.
ANTHROPIC_FOUNDRY_RESOURCE=
# Estimated $ per 1M tokens for the spend caps above. Defaults match Claude
# Haiku 4.5 ($1 in / $5 out per 1M tokens) -- update if using a different
# Claude model. Current pricing: https://www.anthropic.com/pricing#api
ANTHROPIC_INPUT_PRICE_PER_1M=1.00
ANTHROPIC_OUTPUT_PRICE_PER_1M=5.00

# Only used by the "google_drive" and "gmail" source connector types (see
# app/ingestion/google_drive_source.py and app/ingestion/gmail_source.py).
# The full contents of a Google Cloud service account's JSON key, as one
# line. Get one: Google Cloud Console -> create/select a project -> enable
# the "Google Drive API" (and "Gmail API" if you want gmail too) -> IAM &
# Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON. Then
# share the specific Drive folder you want pulled in with that key's
# "client_email" -- the service account can only ever see folders explicitly
# shared with it, nothing else in anyone's Drive. Leave blank to disable
# both connector types.
#
# gmail needs one more step beyond this key: a mailbox can't be "shared"
# with a service account the way a Drive folder can, so a Google Workspace
# admin must grant this service account domain-wide delegation for the
# gmail.readonly scope (Workspace Admin console -> Security -> API controls
# -> Domain-wide Delegation -> add the service account's numeric client id
# with that scope). Domain-wide delegation is a Workspace (paid) feature --
# gmail doesn't work against a personal Gmail account.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Only used by the "sharepoint" and "outlook_mail" source connector types
# (see app/ingestion/sharepoint_source.py and
# app/ingestion/outlook_mail_source.py). An Azure AD (Entra ID) app
# registration's credentials for the OAuth2 client credentials flow against
# Microsoft Graph. Get these: Azure Portal -> Microsoft Entra ID -> App
# registrations -> New registration, then Certificates & secrets -> New
# client secret, then API permissions -> Add a permission -> Microsoft Graph
# -> Application permissions -> Sites.Read.All (for sharepoint) and/or
# Mail.Read (for outlook_mail) -> Grant admin consent. Unlike Drive's
# per-folder sharing, both grants are org-wide once admin-consented --
# there's no separate per-site/per-mailbox invite step. All three env vars
# must be set together, or leave all blank to disable both connector types.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Foundry IQ -- a live, per-query retriever (app/retrieval/foundry_iq_retriever.py),
# not an ingestion connector like the settings above. Get these from the
# Azure AI Search resource hosting the knowledge base: FOUNDRY_IQ_SEARCH_ENDPOINT
# is that resource's own URL (https://<search-service>.search.windows.net),
# FOUNDRY_IQ_API_KEY an admin or query key for it, FOUNDRY_IQ_KNOWLEDGE_BASE
# the knowledge base's name. All three must be set together, or leave all
# blank to disable (queries run exactly as they did before this integration
# existed). One knowledge base can itself be configured, on the Azure AI
# Search side, to span Fabric IQ and Work IQ knowledge sources too -- see
# CLAUDE.md's v7 section.
FOUNDRY_IQ_SEARCH_ENDPOINT=
FOUNDRY_IQ_API_KEY=
FOUNDRY_IQ_KNOWLEDGE_BASE=

# The one-click "Connect Google Drive" button (the "google_drive_oauth"
# connector type) -- a real per-user OAuth consent flow, distinct from the
# service-account setup above. Instead of an operator sharing one folder
# with a service account ahead of time, any user clicks "Connect", signs
# into their own Google account in a popup, and picks the exact files they
# want read via the Google Picker -- one click, no admin/IT step. Scoped to
# drive.file (Google's narrowest Drive scope: this app can only ever read
# files a user explicitly picked, nothing else in their Drive), which is
# also why it needs no Google app-verification process to use in
# production, unlike a broader Drive scope would. Get both from Google
# Cloud Console -> APIs & Services -> Credentials -> Create Credentials ->
# OAuth client ID -> Web application -- add this deployment's own URL (and
# http://localhost:<port> for local dev) under "Authorized JavaScript
# origins"; no redirect URI is needed, the flow uses Google Identity
# Services' popup + postMessage code exchange, not a server redirect.
# client_id ends up embedded in the frontend (that's expected -- it's a
# public identifier, not a secret); client_secret never leaves this server.
# Leave either blank to disable the connector type -- the "Connect Google
# Drive" button simply won't show up.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required before GOOGLE_OAUTH_CLIENT_ID/SECRET above will actually work --
# the symmetric key this server uses to encrypt every OAuth refresh token
# before writing it to Neo4j (see app/graph/token_crypto.py). A refresh
# token is a live credential that can read a real person's picked files, so
# it's never stored in plaintext; there is deliberately no plaintext
# fallback. Generate one: `python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"`. Keep this secret, and
# keep it stable -- rotating it makes every already-connected Drive
# connector unreadable (they'll need to be reconnected).
TOKEN_ENCRYPTION_KEY=

# The one-click "Connect Fabric IQ Ontology"/"Connect Work IQ" buttons
# (app/ingestion/microsoft_oauth.py) -- direct MCP access to Fabric IQ
# Ontology and Work IQ (not through Foundry IQ above), which both require
# DELEGATED user auth per Microsoft's own docs, not a service credential --
# see app/config.py's own comment for why that's a real product decision.
# One Entra app registration (the "BYO Entra app" both providers' docs ask
# for) backs both connector types. Get these from Azure Portal -> Microsoft
# Entra ID -> App registrations -> New registration (platform: Web,
# redirect URI: <PUBLIC_BASE_URL>/static/microsoft-oauth-callback.html),
# then Certificates & secrets -> New client secret. Also needs
# TOKEN_ENCRYPTION_KEY and PUBLIC_BASE_URL set (both likely already are, if
# Google Drive one-click connect above is configured). Leave any of the
# three blank to disable both connector types.
MICROSOFT_OAUTH_TENANT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# The exact delegated scope string each provider's MCP endpoint expects --
# Fabric IQ Ontology's is documented (see the default below); Work IQ's
# isn't documented at the same level of detail, so there's no default --
# check your own tenant's Work IQ MCP server's /.well-known/oauth-protected-resource
# endpoint. Both are preview APIs Microsoft has explicitly flagged as
# subject to change.
FABRIC_IQ_ONTOLOGY_SCOPE=McpServers.FabricIQOntology.All
WORK_IQ_SCOPE=

# Background connector syncing (see app/graph/connector_scheduler.py) --
# every tenant's connectors get synced automatically on this interval, not
# just when someone clicks "Sync now" in the UI. Set to false to disable
# entirely, e.g. for local dev against a database you don't want auto-synced.
CONNECTOR_SYNC_ENABLED=true
CONNECTOR_SYNC_INTERVAL_MINUTES=15

# MCP server (see app/mcp/server.py, v3.5) -- the MCP SDK rejects any request
# whose Host header isn't in this comma-separated list with a 421, regardless
# of API key, as DNS-rebinding protection. The default below covers local dev
# only; a real deployment needs its own public hostname added (with no
# scheme, no path -- just host[:port], matching the Host header exactly).
# scripts/deploy_azure.sh sets this automatically for an Azure deploy.
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000

# This deployment's own public HTTPS URL, no trailing slash (e.g.
# https://saxon-context-engine.example.azurecontainerapps.io) -- used to
# build the notificationUrl a Microsoft Graph push subscription (real-time
# push for the "outlook_mail" connector type; see
# app/ingestion/graph_subscriptions.py) calls back to. Leave blank for
# local dev -- Graph can't reach localhost anyway, so push subscriptions
# just aren't attempted; the connector still works, polled on the normal
# interval. scripts/deploy_azure.sh sets this automatically for an Azure
# deploy, same as MCP_ALLOWED_HOSTS.
PUBLIC_BASE_URL=

# Admin API (see app/api/admin.py, app/graph/tenants.py) -- POST/GET/DELETE
# /api/v1/admin/tenants, protected by this key in an X-Admin-Key header, lets
# you add/remove a tenant live against the running deployment, no redeploy
# needed (unlike TENANT_API_KEYS below, which only takes effect at process
# startup). A separate credential from any tenant's own API key -- generate
# one yourself, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Leave blank to disable the admin API entirely.
ADMIN_API_KEY=

APP_ENV=development
LOG_LEVEL=INFO

# Tenants (which API key belongs to which client, and their own Gemini key)
# are normally managed with `python scripts/manage_tenants.py add/list/remove`,
# which reads/writes config/tenants.json -- see the README's "Adding a client's
# API key" section. TENANT_API_KEYS below is an alternative for platforms that
# prefer environment-variable configuration over a file (e.g. Azure Container
# Apps); config/tenants.json takes priority if both are present. Uncomment and
# fill in only if you're using this route instead of the script:
#
# TENANT_API_KEYS={"<api-key>": {"group_id": "<tenant>", "gemini_api_key": "<their-key>"}}
