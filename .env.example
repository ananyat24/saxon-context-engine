NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Which LLM provider build_graphiti() uses: "gemini" (default, per-tenant
# keys), "azure_openai" (one shared enterprise resource, no per-tenant
# billing isolation but not subject to Gemini's free-tier rate limit), or
# "anthropic" (Claude for extraction/chat/answer-synthesis -- still needs
# GOOGLE_API_KEY below for embeddings/reranking, since Claude has no
# embeddings API of its own). See app/graph/graphiti_adapter.py.
LLM_PROVIDER=gemini

# Fallback key used only by local scripts/tests, never by the API itself --
# see app/config.py. Not needed if you're only running the API.
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001

# Only used when LLM_PROVIDER=azure_openai. Get these from the Azure Portal
# resource's "Keys and Endpoint" page. The two deployment names are whatever
# you named the deployments when you created them in Azure OpenAI Studio, not
# necessarily the underlying model's name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Local spend caps for Azure OpenAI, enforced by the app itself -- see
# app/graph/spend_limiter.py. Useful when you hold an API key but not portal
# access to set a real cap on the resource. Two independent budgets: one for
# data ingestion runs (scripts/ingest_samples.py etc.), one for live/testing
# queries against the API. Once a bucket hits its budget, further calls in
# that bucket are refused (not made) until you raise the number here.
AZURE_OPENAI_INGESTION_BUDGET_USD=30
AZURE_OPENAI_QUERY_BUDGET_USD=20
# Estimated $ per 1M tokens, used to translate token usage into the spend
# tracked above. Defaults match GPT-4.1 (~$2 in / ~$8 out per 1M tokens) +
# text-embedding-3-small ($0.02/1M) -- if your actual deployments use
# different models, update these so the estimate is meaningful. Check the
# exact current price on each deployment's page in Azure AI Foundry, or
# https://azure.microsoft.com/pricing/details/cognitive-services/openai-service/.
# Other common embedding prices, if you're on a different one:
#   text-embedding-3-large: 0.13   text-embedding-ada-002: 0.10
AZURE_OPENAI_INPUT_PRICE_PER_1M=2.00
AZURE_OPENAI_OUTPUT_PRICE_PER_1M=8.00
AZURE_OPENAI_EMBEDDING_PRICE_PER_1M=0.02

# Only used when LLM_PROVIDER=anthropic. Get a key from
# https://console.anthropic.com/. Shares the same ingestion/query spend
# budgets as Azure OpenAI above (AZURE_OPENAI_INGESTION_BUDGET_USD /
# AZURE_OPENAI_QUERY_BUDGET_USD) -- those are provider-agnostic "how much
# this app can spend" caps, not duplicated per-provider.
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5
# If your key was issued through Microsoft Foundry (same place as an Azure
# OpenAI resource) rather than directly from console.anthropic.com, set this
# to the resource name -- the first segment of
# https://<resource>.services.ai.azure.com/anthropic/. Leave blank/unset for
# a direct Anthropic key.
ANTHROPIC_FOUNDRY_RESOURCE=
# Estimated $ per 1M tokens for the spend caps above. Defaults match Claude
# Haiku 4.5 ($1 in / $5 out per 1M tokens) -- update if using a different
# Claude model. Current pricing: https://www.anthropic.com/pricing#api
ANTHROPIC_INPUT_PRICE_PER_1M=1.00
ANTHROPIC_OUTPUT_PRICE_PER_1M=5.00

# Only used by the "google_drive" source connector type (see
# app/ingestion/google_drive_source.py). The full contents of a Google Cloud
# service account's JSON key, as one line. Get one: Google Cloud Console ->
# create/select a project -> enable the "Google Drive API" -> IAM & Admin ->
# Service Accounts -> create one -> Keys -> Add key -> JSON. Then share the
# specific Drive folder you want pulled in with that key's "client_email" --
# the service account can only ever see folders explicitly shared with it,
# nothing else in anyone's Drive. Leave blank to disable this connector type.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Background connector syncing (see app/graph/connector_scheduler.py) --
# every tenant's connectors get synced automatically on this interval, not
# just when someone clicks "Sync now" in the UI. Set to false to disable
# entirely, e.g. for local dev against a database you don't want auto-synced.
CONNECTOR_SYNC_ENABLED=true
CONNECTOR_SYNC_INTERVAL_MINUTES=15

APP_ENV=development
LOG_LEVEL=INFO

# Tenants (which API key belongs to which client, and their own Gemini key)
# are normally managed with `python scripts/manage_tenants.py add/list/remove`,
# which reads/writes config/tenants.json -- see the README's "Adding a client's
# API key" section. TENANT_API_KEYS below is an alternative for platforms that
# prefer environment-variable configuration over a file (e.g. Azure Container
# Apps); config/tenants.json takes priority if both are present. Uncomment and
# fill in only if you're using this route instead of the script:
#
# TENANT_API_KEYS={"<api-key>": {"group_id": "<tenant>", "gemini_api_key": "<their-key>"}}
